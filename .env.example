# ── 이 파일을 .env.local 로 복사한 뒤 값을 채우세요 (.env.local 은 git에 올라가지 않습니다) ──

# Neon Postgres 연결 문자열
# Vercel 대시보드 → Storage → Neon 연결 시 자동으로 주입됩니다.
# 로컬 개발용은 https://console.neon.tech 에서 프로젝트를 만들고 복사하세요.
DATABASE_URL="postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# 재고 페이지 접속 비밀번호 (직원들과 공유할 값)
APP_PASSWORD="여기에-원하는-비밀번호"

# 로그인 쿠키 서명용 비밀키. 아무 긴 임의 문자열이면 됩니다.
# 생성 예: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="여기에-랜덤한-64자-문자열"
